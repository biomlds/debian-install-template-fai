schema_version: 1
identity:
  username: "REPLACE_PERMANENT_USERNAME"
  full_name: "REPLACE_FULL_NAME"
  hostname: "REPLACE_HOSTNAME"
  timezone: "America/Edmonton"
  locale: "en_CA.UTF-8"
account:
  groups: [sudo, audio, video, render, input, plugdev, incus-admin]
  # Exactly one of value or file. Prefer a root-only file on encrypted/removable media.
  login_password:
    file: "/media/secure/login.password"
git:
  name: "REPLACE_GIT_NAME"
  email: "REPLACE_GIT_EMAIL"
ssh:
  private_key_file: "/media/secure/id_ed25519"
  public_key_file: "/media/secure/id_ed25519.pub"
  config_file: "/media/secure/ssh_config"
chezmoi:
  # Use local-scaffold only to initialize the bundled starter configuration.
  repository: "REPLACE_SSH_OR_HTTPS_REPOSITORY_OR_local-scaffold"
  branch: "main"
borg:
  repository: "REPLACE_BORG_REPOSITORY"
  ssh_key_file: "/media/secure/borg_ed25519"
  passphrase:
    file: "/media/secure/borg.passphrase"
vorta:
  profile_name: "Personal files"
  source_paths: ["~"]
  excludes_file: "/media/secure/borg-excludes.txt"
cryptomator:
  vault_path: "~/ColdStorage/Cryptomator"
  password:
    file: "/media/secure/cryptomator.password"
grub:
  username: "workstation-admin"
  password:
    file: "/media/secure/grub.password"
luks:
  passphrase:
    file: "/media/secure/luks.passphrase"
