#!/usr/bin/env python3
"""Resumable first-boot workstation setup.

Secrets exist only in process memory or a root-only directory under /run. Logs contain
stage names and outcomes, never values, subprocess output, or command lines.
"""
from __future__ import annotations

import argparse
import contextlib
import fcntl
import getpass
import hashlib
import json
import os
import pwd
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

import yaml

STATE_DIR = Path("/var/lib/workstation-firstboot")
STATE_FILE = STATE_DIR / "state.json"
PENDING = STATE_DIR / "pending"
LOCK_FILE = STATE_DIR / "lock"
LOG_FILE = Path("/var/log/workstation-firstboot.log")
PROVISION_ENV = Path("/etc/workstation-bootstrap/provision.env")
LUKS_META = Path("/etc/workstation-bootstrap/luks-bootstrap.json")
KPX_PREFIX = "Workstation Bootstrap"
STAGES = ["account", "identity_ssh", "chezmoi", "backup", "grub", "luks", "verification"]


class SetupError(RuntimeError):
    pass


def die(message: str) -> None:
    raise SetupError(message)


def require_root() -> None:
    if os.geteuid() != 0:
        die("Run with sudo or as root.")


def atomic_write(path: Path, data: bytes, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb", closefd=True) as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
        os.chmod(path, mode)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(name)


def log(message: str) -> None:
    try:
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(LOG_FILE, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        try:
            os.write(fd, f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {message}\n".encode())
        finally:
            os.close(fd)
    except PermissionError:
        # Read-only validation is allowed as an unprivileged user.
        return


def run(cmd: list[str], *, input_data: bytes | None = None, check: bool = True,
        capture: bool = False, user: str | None = None) -> subprocess.CompletedProcess[bytes]:
    actual = cmd
    cwd: str | None = None
    if user:
        try:
            account = pwd.getpwnam(user)
        except KeyError as exc:
            raise SetupError(f"Target account does not exist: {user}") from exc
        cwd = account.pw_dir
        shell = account.pw_shell or "/bin/bash"
        actual = [
            "runuser", "-u", user, "--", "env",
            f"HOME={account.pw_dir}", f"USER={user}", f"LOGNAME={user}", f"SHELL={shell}",
            *cmd,
        ]
    proc = subprocess.run(
        actual,
        input=input_data,
        cwd=cwd,
        stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
        stderr=subprocess.PIPE if capture else subprocess.DEVNULL,
        check=False,
    )
    if check and proc.returncode:
        raise SetupError(f"Command failed safely: {Path(cmd[0]).name} (exit {proc.returncode}).")
    return proc


def output(cmd: list[str], *, input_data: bytes | None = None) -> str:
    return run(cmd, input_data=input_data, capture=True).stdout.decode(errors="replace").strip()


def load_env(path: Path) -> dict[str, str]:
    result: dict[str, str] = {}
    if not path.exists():
        return result
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        result[key] = value.strip().strip("'\"")
    return result


def safe_input_file(path: Path, allow_insecure: bool = False) -> None:
    st = path.stat()
    if not stat.S_ISREG(st.st_mode):
        die(f"Input is not a regular file: {path}")
    if st.st_mode & 0o077 and not allow_insecure:
        die(f"Unsafe input permissions on {path}; require mode 0600/0400 or use the explicit recovery override.")
    allowed_owners = {0, os.getuid()}
    if os.environ.get("SUDO_UID", "").isdigit():
        allowed_owners.add(int(os.environ["SUDO_UID"]))
    if st.st_uid not in allowed_owners and not allow_insecure:
        die(f"Input owner is neither root nor the invoking user: {path}")


@dataclass
class SecretStore:
    root: Path = field(init=False)

    def __post_init__(self) -> None:
        candidates = [Path(f"/run/user/{os.getuid()}"), Path("/dev/shm"), Path("/tmp")]
        base = next((path for path in candidates if path.is_dir() and os.access(path, os.W_OK)), Path("/tmp"))
        self.root = Path(tempfile.mkdtemp(prefix="workstation-firstboot.", dir=base))
        os.chmod(self.root, 0o700)

    def put(self, name: str, value: bytes, *, single_line: bool = True) -> Path:
        if not value or b"\x00" in value:
            die(f"Secret {name} must be non-empty and contain no NUL characters.")
        if single_line and (b"\n" in value or b"\r" in value):
            die(f"Secret {name} must contain no newline characters.")
        path = self.root / name
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        try:
            os.write(fd, value)
            os.fsync(fd)
        finally:
            os.close(fd)
        return path

    def copy(self, name: str, source: Path, allow_insecure: bool = False,
             *, single_line: bool = False) -> Path:
        safe_input_file(source, allow_insecure)
        return self.put(name, source.read_bytes().rstrip(b"\r\n"), single_line=single_line)

    def cleanup(self) -> None:
        if self.root.exists():
            for item in self.root.iterdir():
                with contextlib.suppress(Exception):
                    if item.is_file():
                        size = item.stat().st_size
                        with item.open("r+b", buffering=0) as stream:
                            stream.write(b"\x00" * size)
                with contextlib.suppress(Exception):
                    item.unlink()
            shutil.rmtree(self.root, ignore_errors=True)


@dataclass
class Model:
    source: str
    username: str
    full_name: str
    hostname: str
    login_password: Path
    groups: list[str]
    git_name: str
    git_email: str
    ssh_private_key: Path
    ssh_public_key: Path
    ssh_config: Path | None
    chezmoi_repo: str
    chezmoi_branch: str
    borg_repository: str
    borg_ssh_key: Path | None
    vorta_profile: str
    vorta_source_paths: list[str]
    vorta_excludes: Path | None
    cryptomator_vault: str
    grub_username: str
    grub_password: Path
    luks_passphrase: Path
    timezone: str = "America/Edmonton"
    locale: str = "en_CA.UTF-8"

    def public_fingerprint(self) -> str:
        public = {
            "source": self.source, "username": self.username, "full_name": self.full_name,
            "hostname": self.hostname, "git_name": self.git_name, "git_email": self.git_email,
            "groups": self.groups,
            "chezmoi_repo": self.chezmoi_repo, "chezmoi_branch": self.chezmoi_branch,
            "borg_repository": self.borg_repository, "cryptomator_vault": self.cryptomator_vault,
            "vorta_profile": self.vorta_profile, "vorta_source_paths": self.vorta_source_paths,
            "grub_username": self.grub_username, "timezone": self.timezone, "locale": self.locale,
        }
        return hashlib.sha256(json.dumps(public, sort_keys=True).encode()).hexdigest()


class InputProvider:
    def __init__(self, args: argparse.Namespace, secrets: SecretStore):
        self.args = args
        self.secrets = secrets

    def missing_text(self, label: str, secret: bool = False) -> str:
        if self.args.non_interactive:
            die(f"Missing required value: {label}")
        value = getpass.getpass(f"{label}: ") if secret else input(f"{label}: ").strip()
        if not value:
            die(f"Required value was empty: {label}")
        return value

    def missing_file(self, label: str) -> Path:
        if self.args.non_interactive:
            die(f"Missing required file: {label}")
        value = Path(input(f"{label} path: ").strip()).expanduser()
        if not value.is_file():
            die(f"File not found: {value}")
        return value

    def close(self) -> None:
        return


class YamlProvider(InputProvider):
    def __init__(self, args: argparse.Namespace, secrets: SecretStore):
        super().__init__(args, secrets)
        self.path = Path(args.config).expanduser().resolve()
        safe_input_file(self.path, args.allow_insecure_input_permissions)
        self.data = yaml.safe_load(self.path.read_text())
        if not isinstance(self.data, dict) or self.data.get("schema_version") != 1:
            die("config.yaml must be a mapping with schema_version: 1.")

    def value(self, path: str, *, required: bool = True, default: str = "") -> str:
        node: Any = self.data
        for part in path.split("."):
            node = node.get(part) if isinstance(node, dict) else None
        if node is None or node == "":
            return self.missing_text(path) if required else default
        if not isinstance(node, str):
            die(f"Expected string at {path}.")
        return node

    def secret(self, path: str, name: str) -> Path:
        node: Any = self.data
        for part in path.split("."):
            node = node.get(part) if isinstance(node, dict) else None
        if node is not None and not isinstance(node, dict):
            die(f"{path} must be a mapping containing exactly one of value or file.")
        if isinstance(node, dict):
            keys = {key for key in ("value", "file") if node.get(key) not in (None, "")}
            if len(keys) != 1:
                die(f"{path} must contain exactly one of value or file.")
            if "value" in keys:
                value = node["value"]
                if not isinstance(value, str):
                    die(f"{path}.value must be a string.")
                return self.secrets.put(name, value.encode())
            source = Path(str(node["file"])).expanduser().resolve()
            return self.secrets.copy(name, source, self.args.allow_insecure_input_permissions, single_line=True)
        value = self.missing_text(path, secret=True)
        return self.secrets.put(name, value.encode())

    def list_value(self, path: str, default: list[str]) -> list[str]:
        node: Any = self.data
        for part in path.split("."):
            node = node.get(part) if isinstance(node, dict) else None
        if node is None:
            return default
        if not isinstance(node, list) or not all(isinstance(item, str) for item in node):
            die(f"Expected a list of strings at {path}.")
        return node

    def file(self, path: str, name: str, required: bool = True) -> Path | None:
        raw = self.value(path, required=False)
        if not raw:
            if not required:
                return None
            source = self.missing_file(path)
        else:
            source = Path(raw).expanduser().resolve()
        return self.secrets.copy(name, source, self.args.allow_insecure_input_permissions)

    def model(self) -> Model:
        return Model(
            source="yaml",
            username=self.value("identity.username"), full_name=self.value("identity.full_name"),
            hostname=self.value("identity.hostname"), login_password=self.secret("account.login_password", "login"),
            groups=self.list_value("account.groups", ["sudo", "audio", "video", "render", "input", "plugdev", "incus-admin"]),
            git_name=self.value("git.name"), git_email=self.value("git.email"),
            ssh_private_key=self.file("ssh.private_key_file", "ssh-private"),
            ssh_public_key=self.file("ssh.public_key_file", "ssh-public"),
            ssh_config=self.file("ssh.config_file", "ssh-config", required=False),
            chezmoi_repo=self.value("chezmoi.repository"), chezmoi_branch=self.value("chezmoi.branch", required=False, default="main"),
            borg_repository=self.value("borg.repository"), borg_ssh_key=self.file("borg.ssh_key_file", "borg-key", required=False),
            vorta_profile=self.value("vorta.profile_name", required=False, default="Personal files"),
            vorta_source_paths=self.list_value("vorta.source_paths", ["~"]),
            vorta_excludes=self.file("vorta.excludes_file", "vorta-excludes", required=False),
            cryptomator_vault=self.value("cryptomator.vault_path"),
            grub_username=self.value("grub.username", required=False, default="workstation-admin"),
            grub_password=self.secret("grub.password", "grub-pass"),
            luks_passphrase=self.secret("luks.passphrase", "luks-pass"),
            timezone=self.value("identity.timezone", required=False, default="America/Edmonton"),
            locale=self.value("identity.locale", required=False, default="en_CA.UTF-8"),
        )


class KeePassProvider(InputProvider):
    def __init__(self, args: argparse.Namespace, secrets: SecretStore):
        super().__init__(args, secrets)
        if not shutil.which("keepassxc-cli"):
            die("keepassxc-cli is not installed.")
        self.database = Path(args.database or default_database()).expanduser().resolve()
        safe_input_file(self.database, args.allow_insecure_input_permissions)
        self.master = bytearray(getpass.getpass("KeePassXC database password: ").encode())
        if not self.master:
            die("KeePassXC database password was empty.")
        self.prefix = args.entry_prefix.strip("/") or KPX_PREFIX

    def _stdin(self) -> bytes:
        return bytes(self.master) + b"\n"

    def close(self) -> None:
        for index in range(len(self.master)):
            self.master[index] = 0

    def attr(self, entry: str, attribute: str, *, required: bool = True, secret: bool = False) -> str:
        proc = run(
            ["keepassxc-cli", "show", "-q", "-a", attribute, str(self.database), f"{self.prefix}/{entry}"],
            input_data=self._stdin(), check=False, capture=True,
        )
        raw = proc.stdout.decode(errors="replace") if proc.returncode == 0 else ""
        value = raw.rstrip("\r\n") if secret else raw.strip()
        if not value and required:
            value = self.missing_text(f"KeePassXC {entry}.{attribute}", secret=secret)
        return value

    def secret(self, entry: str, name: str) -> Path:
        value = self.attr(entry, "Password", secret=True)
        return self.secrets.put(name, value.encode())

    def attachment(self, entry: str, attachment: str, name: str, required: bool = True) -> Path | None:
        output_path = self.secrets.root / name
        proc = run(
            ["keepassxc-cli", "attachment-export", "-q", str(self.database),
             f"{self.prefix}/{entry}", attachment, str(output_path)],
            input_data=self._stdin(), check=False, capture=True,
        )
        if proc.returncode == 0 and output_path.is_file() and output_path.stat().st_size:
            os.chmod(output_path, 0o600)
            return output_path
        with contextlib.suppress(FileNotFoundError):
            output_path.unlink()
        if not required:
            return None
        source = self.missing_file(f"KeePassXC missing attachment {entry}/{attachment}")
        return self.secrets.copy(name, source, self.args.allow_insecure_input_permissions)

    def model(self) -> Model:
        return Model(
            source="keepassxc",
            username=self.attr("Identity", "Username"), full_name=self.attr("Identity", "FullName"),
            hostname=self.attr("Identity", "Hostname"), login_password=self.secret("Login", "login"),
            groups=[group.strip() for group in (self.attr("Login", "Groups", required=False) or "sudo,audio,video,render,input,plugdev,incus-admin").split(",") if group.strip()],
            git_name=self.attr("Git", "Name"), git_email=self.attr("Git", "Email"),
            ssh_private_key=self.attachment("SSH", "id_ed25519", "ssh-private"),
            ssh_public_key=self.attachment("SSH", "id_ed25519.pub", "ssh-public"),
            ssh_config=self.attachment("SSH", "config", "ssh-config", required=False),
            chezmoi_repo=self.attr("Chezmoi", "Repository"),
            chezmoi_branch=self.attr("Chezmoi", "Branch", required=False) or "main",
            borg_repository=self.attr("Borg", "Repository"),
            borg_ssh_key=self.attachment("Borg", "borg_ed25519", "borg-key", required=False),
            vorta_profile=self.attr("Vorta", "ProfileName", required=False) or "Personal files",
            vorta_source_paths=[item.strip() for item in (self.attr("Vorta", "SourcePaths", required=False) or "~").split(",") if item.strip()],
            vorta_excludes=self.attachment("Vorta", "excludes.txt", "vorta-excludes", required=False),
            cryptomator_vault=self.attr("Cryptomator", "VaultPath"),
            grub_username=self.attr("GRUB", "Username", required=False) or "workstation-admin",
            grub_password=self.secret("GRUB", "grub-pass"),
            luks_passphrase=self.secret("LUKS", "luks-pass"),
            timezone=self.attr("Identity", "Timezone", required=False) or "America/Edmonton",
            locale=self.attr("Identity", "Locale", required=False) or "en_CA.UTF-8",
        )


def default_database() -> str:
    user = os.environ.get("SUDO_USER") or "provision"
    try:
        home = pwd.getpwnam(user).pw_dir
    except KeyError:
        home = f"/home/{user}"
    return f"{home}/Documents/Secrets/Passwords.kdbx"


def validate_model(model: Model) -> None:
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,30}", model.username):
        die("Permanent username is not a valid local account name.")
    if model.username in {"root", "provision"}:
        die("Permanent username must differ from root and provision.")
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9.-]{0,62}", model.hostname):
        die("Hostname is invalid.")
    if "@" not in model.git_email or "\n" in model.git_email:
        die("Git email is invalid.")
    if "sudo" not in model.groups or any(not re.fullmatch(r"[a-z_][a-z0-9_-]{0,30}", group) for group in model.groups):
        die("Account groups must be valid local group names and include sudo.")
    if ":" in model.full_name:
        die("Full name may not contain ':' because useradd uses it as a field separator.")
    if any("\n" in value or "\r" in value for value in (
        model.full_name, model.git_name, model.chezmoi_repo, model.borg_repository,
        model.vorta_profile, model.cryptomator_vault, model.grub_username,
    )):
        die("Text fields may not contain newlines.")
    if not model.vorta_source_paths or any("\n" in value or "\r" in value for value in model.vorta_source_paths):
        die("Vorta source paths must be a non-empty list without newlines.")
    if not re.fullmatch(r"[A-Za-z0-9_.-]+_[A-Za-z0-9_.@-]+", model.locale):
        die("Locale is invalid.")
    zone_root = Path("/usr/share/zoneinfo").resolve()
    if Path(model.timezone).is_absolute():
        die("Timezone must be a relative name from the installed zoneinfo database.")
    zone = (zone_root / model.timezone).resolve()
    if not zone.is_file() or not zone.is_relative_to(zone_root):
        die("Timezone is not present in the installed zoneinfo database.")
    for path in (model.login_password, model.ssh_private_key, model.ssh_public_key,
                 model.grub_password, model.luks_passphrase):
        if not path or not path.is_file() or path.stat().st_size == 0:
            die("A required secret or key file is missing.")
    public = model.ssh_public_key.read_text(errors="strict").strip()
    if not re.fullmatch(r"(?:ssh-(?:ed25519|rsa)|ecdsa-sha2-nistp(?:256|384|521)) [A-Za-z0-9+/]+={0,2}(?: [^\r\n]*)?", public):
        die("SSH public key has an unsupported format.")
    if len(model.login_password.read_bytes()) < 12 or len(model.luks_passphrase.read_bytes()) < 16 or len(model.grub_password.read_bytes()) < 12:
        die("Login/GRUB credentials require 12+ characters and LUKS requires 16+ characters.")


def load_state() -> dict[str, Any]:
    if not STATE_FILE.exists():
        return {"schema": 1, "completed": []}
    safe_input_file(STATE_FILE)
    data = json.loads(STATE_FILE.read_text())
    if data.get("schema") != 1 or not isinstance(data.get("completed"), list):
        die("Invalid first-boot state file.")
    return data


def save_state(state: dict[str, Any]) -> None:
    atomic_write(STATE_FILE, (json.dumps(state, indent=2, sort_keys=True) + "\n").encode(), 0o600)


def stage_done(state: dict[str, Any], stage: str) -> bool:
    return stage in state["completed"]


def complete_stage(state: dict[str, Any], stage: str) -> None:
    if stage not in state["completed"]:
        state["completed"].append(stage)
    save_state(state)
    log(f"stage={stage} result=complete")


def existing_groups(names: list[str]) -> list[str]:
    result = []
    for name in names:
        if run(["getent", "group", name], check=False).returncode == 0:
            result.append(name)
    return result


def ensure_account(model: Model) -> None:
    if run(["id", model.username], check=False).returncode != 0:
        run(["useradd", "--create-home", "--shell", "/bin/bash", "--comment", model.full_name, model.username])
    password = model.login_password.read_bytes()
    if b":" in password:
        die("Login password may not contain ':' because chpasswd uses a colon-delimited protocol.")
    run(["chpasswd"], input_data=model.username.encode() + b":" + password + b"\n")
    groups = existing_groups(model.groups)
    if groups:
        run(["usermod", "--append", "--groups", ",".join(groups), model.username])
    status = output(["passwd", "-S", model.username]).split()
    if len(status) < 2 or status[1] not in {"P", "PS"}:
        die("Permanent account password remains locked.")
    if run(["sudo", "-n", "-l", "-U", model.username], check=False).returncode != 0:
        die("Permanent user does not have a valid sudo policy.")
    if shutil.which("pamtester") and run(
        ["pamtester", "login", model.username, "authenticate"], input_data=password + b"\n", check=False
    ).returncode != 0:
        die("PAM authentication test failed for the permanent user.")


def install_identity_ssh(model: Model) -> None:
    run(["hostnamectl", "set-hostname", model.hostname])
    run(["timedatectl", "set-timezone", model.timezone])
    locale_line = f"{model.locale} UTF-8"
    locale_gen = Path("/etc/locale.gen")
    locale_lines = locale_gen.read_text().splitlines() if locale_gen.exists() else []
    if locale_line not in locale_lines:
        locale_lines.append(locale_line)
        atomic_write(locale_gen, ("\n".join(locale_lines) + "\n").encode(), 0o644)
        run(["locale-gen"])
    atomic_write(Path("/etc/default/locale"), f"LANG={model.locale}\n".encode(), 0o644)
    hosts = Path("/etc/hosts")
    lines = [line for line in hosts.read_text().splitlines() if not line.startswith("127.0.1.1")]
    lines.append(f"127.0.1.1 {model.hostname}")
    atomic_write(hosts, ("\n".join(lines) + "\n").encode(), 0o644)
    pw = pwd.getpwnam(model.username)
    home = Path(pw.pw_dir)
    ssh = home / ".ssh"
    ssh.mkdir(mode=0o700, parents=True, exist_ok=True)
    shutil.copyfile(model.ssh_private_key, ssh / "id_ed25519")
    shutil.copyfile(model.ssh_public_key, ssh / "id_ed25519.pub")
    os.chmod(ssh / "id_ed25519", 0o600)
    os.chmod(ssh / "id_ed25519.pub", 0o644)
    shutil.copyfile(model.ssh_public_key, ssh / "authorized_keys")
    os.chmod(ssh / "authorized_keys", 0o600)
    if model.ssh_config:
        shutil.copyfile(model.ssh_config, ssh / "config")
        os.chmod(ssh / "config", 0o600)
    for path in [ssh, *ssh.iterdir()]:
        os.chown(path, pw.pw_uid, pw.pw_gid)
    run(["git", "config", "--global", "user.name", model.git_name], user=model.username)
    run(["git", "config", "--global", "user.email", model.git_email], user=model.username)


def setup_chezmoi(model: Model) -> None:
    if not shutil.which("chezmoi"):
        die("chezmoi binary is missing; rebuild the ISO with tools/build-host-tools.sh.")
    pw = pwd.getpwnam(model.username)
    home = Path(pw.pw_dir)
    source = home / ".local/share/chezmoi"
    if model.chezmoi_repo == "local-scaffold":
        template = Path("/usr/local/share/workstation-bootstrap/chezmoi")
        if not source.exists():
            shutil.copytree(template, source)
            for path in [source, *source.rglob("*")]:
                os.chown(path, pw.pw_uid, pw.pw_gid)
        run(["chezmoi", "init", "--source", str(source), "--apply"], user=model.username)
    else:
        run(["chezmoi", "init", "--apply", "--branch", model.chezmoi_branch, model.chezmoi_repo], user=model.username)


def setup_backup(model: Model) -> None:
    pw = pwd.getpwnam(model.username)
    home = Path(pw.pw_dir)
    home_resolved = home.resolve()
    config_dir = home / ".config/borg"
    config_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    ssh_dir = home / ".ssh"
    ssh_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(ssh_dir, 0o700)
    os.chown(ssh_dir, pw.pw_uid, pw.pw_gid)
    lines = [f"BORG_REPO={shlex.quote(model.borg_repository)}"]
    if model.borg_ssh_key:
        key_target = ssh_dir / "borg_ed25519"
        shutil.copyfile(model.borg_ssh_key, key_target)
        os.chmod(key_target, 0o600)
        os.chown(key_target, pw.pw_uid, pw.pw_gid)
        lines.append("BORG_RSH=" + shlex.quote(f"ssh -i {key_target}"))
    env_file = config_dir / "bootstrap.env"
    atomic_write(env_file, ("\n".join(lines) + "\n").encode(), 0o600)
    os.chown(config_dir, pw.pw_uid, pw.pw_gid)
    os.chown(env_file, pw.pw_uid, pw.pw_gid)
    raw_vault = model.cryptomator_vault
    if raw_vault == "~":
        vault = home
    elif raw_vault.startswith("~/"):
        vault = home / raw_vault[2:]
    elif raw_vault == "$HOME":
        vault = home
    elif raw_vault.startswith("$HOME/"):
        vault = home / raw_vault[6:]
    else:
        vault = Path(raw_vault)
    if not vault.is_absolute():
        vault = home / vault
    vault = vault.resolve()
    if not vault.is_relative_to(home_resolved):
        die("Cryptomator vault path must resolve inside the permanent user's home.")
    vault.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(vault, 0o700)
    os.chown(vault, pw.pw_uid, pw.pw_gid)
    note = home / ".config/borg/VORTA-FIRST-LOGIN.txt"
    atomic_write(note, (
        f"Profile: {model.vorta_profile}\nRepository: {model.borg_repository}\n"
        f"Source paths: {', '.join(model.vorta_source_paths)}\n"
        "Open Vorta, add this repository and paths, and enter the Borg passphrase "
        "from your password manager after login.\n"
    ).encode(), 0o600)
    os.chown(note, pw.pw_uid, pw.pw_gid)
    if model.vorta_excludes:
        excludes = home / ".config/borg/vorta-excludes.txt"
        shutil.copyfile(model.vorta_excludes, excludes)
        os.chmod(excludes, 0o600)
        os.chown(excludes, pw.pw_uid, pw.pw_gid)


def grub_hash(secret: Path) -> str:
    password = secret.read_bytes()
    proc = run(["grub-mkpasswd-pbkdf2"], input_data=password + b"\n" + password + b"\n", capture=True)
    match = re.search(rb"grub\.pbkdf2\.sha512\.[0-9]+\.[A-Fa-f0-9]+\.[A-Fa-f0-9]+", proc.stdout)
    if not match:
        die("Could not parse locally generated GRUB PBKDF2 hash.")
    return match.group(0).decode()


def setup_grub(model: Model) -> None:
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,32}", model.grub_username):
        die("GRUB username is invalid.")
    digest = grub_hash(model.grub_password)
    script = f'''#!/bin/sh\ncat <<'GRUB_AUTH'\nset superusers="{model.grub_username}"\npassword_pbkdf2 {model.grub_username} {digest}\nGRUB_AUTH\n'''
    atomic_write(Path("/etc/grub.d/01_workstation_users"), script.encode(), 0o700)
    run(["/usr/local/sbin/update-grub-secure"])
    if Path("/etc/grub.d/41_snapshots-btrfs").exists():
        run(["systemctl", "enable", "--now", "grub-btrfsd.service"], check=False)
    run(["systemctl", "enable", "grub-security-refresh.path"], check=False)


def luks_device() -> Path:
    source = output(["findmnt", "-n", "-o", "SOURCE", "/"]).split("[", 1)[0]
    source_path = Path(os.path.realpath(source))
    candidates: list[Path] = []
    status = run(["cryptsetup", "status", source], check=False, capture=True)
    if status.returncode == 0:
        for line in status.stdout.decode(errors="replace").splitlines():
            if line.strip().startswith("device:"):
                candidates.append(Path(os.path.realpath(line.split(":", 1)[1].strip())))
    ancestry = run(["lsblk", "-sno", "PATH", str(source_path)], check=False, capture=True)
    candidates.extend(Path(os.path.realpath(line.strip())) for line in ancestry.stdout.decode().splitlines() if line.strip())
    seen: set[str] = set()
    for candidate in candidates:
        key = str(candidate)
        if key in seen:
            continue
        seen.add(key)
        if run(["cryptsetup", "isLuks", key], check=False).returncode == 0:
            return candidate
    die("Could not robustly identify the LUKS backing device for root.")


def active_slots(device: Path) -> list[int]:
    raw = output(["cryptsetup", "luksDump", "--dump-json-metadata", str(device)])
    data = json.loads(raw)
    return sorted(int(slot) for slot in data.get("keyslots", {}))


def matching_slots(device: Path, key: Path) -> list[int]:
    result = []
    for slot in active_slots(device):
        if run(["cryptsetup", "open", "--test-passphrase", "--key-slot", str(slot),
                "--key-file", str(key), str(device)], check=False).returncode == 0:
            result.append(slot)
    return result


def luks_status() -> dict[str, Any]:
    meta = json.loads(LUKS_META.read_text())
    device = luks_device()
    uuid = output(["cryptsetup", "luksUUID", str(device)])
    if uuid != meta.get("luks_uuid"):
        die("Root LUKS UUID does not match installation metadata.")
    slots = active_slots(device)
    temp_slot = int(meta["temporary_slot"])
    key = Path(meta["temporary_key"])
    return {
        "device": str(device), "uuid": uuid, "active_slots": slots,
        "temporary_slot": temp_slot, "temporary_slot_active": temp_slot in slots,
        "temporary_key_present": key.is_file(), "temporary_key": str(key),
    }


def rotate_luks(model: Model) -> None:
    meta = json.loads(LUKS_META.read_text())
    status = luks_status()
    device = Path(status["device"])
    temp_slot = status["temporary_slot"]
    temp_key = Path(status["temporary_key"])
    permanent_matches = matching_slots(device, model.luks_passphrase)
    if not permanent_matches:
        if not temp_key.is_file() or temp_slot not in active_slots(device):
            die("Permanent key is absent and the recorded temporary key is unavailable. Use recovery media; no slot was removed.")
        if temp_slot not in matching_slots(device, temp_key):
            die("Recorded temporary key does not unlock its recorded slot.")
        used = set(active_slots(device))
        free = next((slot for slot in range(32) if slot not in used), None)
        if free is None:
            die("No free LUKS2 keyslot; no change made.")
        run(["cryptsetup", "luksAddKey", "--pbkdf", "pbkdf2", "--key-file", str(temp_key),
             "--new-key-slot", str(free), str(device), str(model.luks_passphrase)])
        permanent_matches = matching_slots(device, model.luks_passphrase)
        if free not in permanent_matches:
            die("Permanent LUKS key verification failed; temporary slot remains active.")
    permanent_slot = next((slot for slot in permanent_matches if slot != temp_slot), None)
    if permanent_slot is None:
        die("Permanent credential does not occupy a slot distinct from the temporary slot.")
    if run(["cryptsetup", "open", "--test-passphrase", "--key-slot", str(permanent_slot),
           "--key-file", str(model.luks_passphrase), str(device)], check=False).returncode != 0:
        die("Permanent LUKS credential failed a final unlock test.")
    slots = active_slots(device)
    if temp_slot in slots:
        if len(slots) < 2:
            die("Refusing to remove the last active LUKS keyslot.")
        atomic_write(STATE_DIR / "luks-rotation.json", json.dumps({
            "schema": 1, "luks_uuid": status["uuid"], "permanent_slot": permanent_slot,
            "temporary_slot": temp_slot, "phase": "permanent-verified",
        }, sort_keys=True).encode() + b"\n", 0o600)
        run(["cryptsetup", "luksKillSlot", "--key-file", str(model.luks_passphrase),
             str(device), str(temp_slot)])
        if temp_slot in active_slots(device):
            die("Temporary LUKS slot remains active; stopped before cleanup.")
        if run(["cryptsetup", "open", "--test-passphrase", "--key-slot", str(permanent_slot),
               "--key-file", str(model.luks_passphrase), str(device)], check=False).returncode != 0:
            die("Permanent key failed after temporary-slot removal. Boot remains unlocked now; use recovery before reboot.")
    if len(active_slots(device)) < 1:
        die("No active LUKS keyslots remain; emergency recovery is required.")
    with contextlib.suppress(FileNotFoundError):
        size = temp_key.stat().st_size
        with temp_key.open("r+b", buffering=0) as stream:
            stream.write(b"\x00" * size)
            stream.flush(); os.fsync(stream.fileno())
        temp_key.unlink()
    atomic_write(STATE_DIR / "luks-rotation.json", json.dumps({
        "schema": 1, "luks_uuid": status["uuid"], "permanent_slot": permanent_slot,
        "temporary_slot": temp_slot, "phase": "complete",
    }, sort_keys=True).encode() + b"\n", 0o600)


def verify_system(model: Model) -> None:
    ensure_account(model)
    status = luks_status()
    if status["temporary_slot_active"] or status["temporary_key_present"]:
        die("Temporary LUKS material is still active.")
    run(["/usr/local/sbin/grub-security-check"])
    if output(["findmnt", "-n", "-o", "FSTYPE", "/"]) != "btrfs":
        die("Root is not Btrfs.")
    for mountpoint, subvol in (("/", "@root"), ("/home", "@home"), ("/.snapshots", "@snapshots")):
        opts = output(["findmnt", "-n", "-o", "OPTIONS", mountpoint])
        if f"subvol=/{subvol}" not in opts and f"subvol={subvol}" not in opts:
            die(f"{mountpoint} is not mounted from {subvol}.")


def apply(args: argparse.Namespace) -> None:
    require_root()
    env = load_env(PROVISION_ENV)
    provision = env.get("PROVISION_USER", "provision")
    sudo_user = os.environ.get("SUDO_USER", "root")
    if sudo_user not in {provision, "root"} and not args.recovery:
        die(f"Run initial apply from {provision}; use --recovery only for documented recovery.")
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    lock_fd = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o600)
    fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    secrets = SecretStore()
    provider: InputProvider | None = None
    try:
        provider = YamlProvider(args, secrets) if args.source == "yaml" else KeePassProvider(args, secrets)
        model = provider.model()
        validate_model(model)
        state = load_state()
        if state.get("finalized") and not args.recovery:
            die("First boot is already finalized; use --recovery only for documented recovery.")
        fingerprint = model.public_fingerprint()
        if state.get("fingerprint") not in (None, fingerprint):
            if not args.accept_config_change:
                die("Non-secret input differs from the previous run; inspect state and use --accept-config-change deliberately.")
            if "luks" in state.get("completed", []):
                die("Configuration cannot be changed after LUKS rotation; complete or recover the current setup first.")
            state["completed"] = []
        state.update({"fingerprint": fingerprint, "username": model.username, "source": model.source})
        save_state(state)
        steps = {
            "account": lambda: ensure_account(model),
            "identity_ssh": lambda: install_identity_ssh(model),
            "chezmoi": lambda: setup_chezmoi(model),
            "backup": lambda: setup_backup(model),
            "grub": lambda: setup_grub(model),
            "luks": lambda: rotate_luks(model),
            "verification": lambda: verify_system(model),
        }
        print("WARNING: setup is fail-closed and resumable. The provisioning account remains until explicit finalize.")
        for stage in STAGES:
            if stage_done(state, stage):
                print(f"SKIP {stage}: already complete")
                continue
            print(f"RUN  {stage}")
            log(f"stage={stage} result=start")
            steps[stage]()
            complete_stage(state, stage)
            print(f"OK   {stage}")
        PENDING.unlink(missing_ok=True)
        atomic_write(STATE_DIR / "ready-to-finalize", b"verified\n", 0o600)
        print(f"Setup verified. Log out, sign in as {model.username}, then run: sudo workstation-firstboot finalize")
    finally:
        if provider:
            provider.close()
        secrets.cleanup()
        os.close(lock_fd)


def status_command() -> None:
    require_root()
    state = load_state()
    print(f"Completed stages: {', '.join(state.get('completed', [])) or 'none'}")
    print(f"Permanent user: {state.get('username', 'not recorded')}")
    print(f"Pending marker: {'present' if PENDING.exists() else 'absent'}")
    try:
        status = luks_status()
        print(f"Root LUKS UUID: {status['uuid']}")
        print(f"Active keyslots: {','.join(map(str, status['active_slots']))}")
        print(f"Temporary slot active: {status['temporary_slot_active']}")
        print(f"Temporary key file present: {status['temporary_key_present']}")
    except Exception as exc:
        print(f"LUKS status: ERROR: {exc}")
    grub = run(["/usr/local/sbin/grub-security-check"], check=False)
    print(f"GRUB policy check: {'pass' if grub.returncode == 0 else 'fail'}")


def validate_input(args: argparse.Namespace) -> None:
    secrets = SecretStore()
    provider: InputProvider | None = None
    try:
        provider = YamlProvider(args, secrets) if args.source == "yaml" else KeePassProvider(args, secrets)
        model = provider.model()
        validate_model(model)
        print("Input schema, required values, secret references, and permissions are valid. No system changes made.")
    finally:
        if provider:
            provider.close()
        secrets.cleanup()


def finalize(args: argparse.Namespace) -> None:
    require_root()
    state = load_state()
    missing = [stage for stage in STAGES if stage not in state.get("completed", [])]
    if missing:
        die(f"Cannot finalize; incomplete stages: {', '.join(missing)}")
    user = state.get("username")
    if not user or run(["id", user], check=False).returncode != 0:
        die("Permanent user does not exist.")
    sudo_user = os.environ.get("SUDO_USER", "root")
    if sudo_user != user and not args.recovery:
        die(f"Log in as {user} and run finalize through sudo. Use --recovery only after manual verification.")
    run(["sudo", "-n", "-l", "-U", user])
    lst = luks_status()
    if lst["temporary_slot_active"] or lst["temporary_key_present"]:
        die("Temporary LUKS material remains; refusing to remove provisioning account.")
    run(["/usr/local/sbin/grub-security-check"])
    provision = load_env(PROVISION_ENV).get("PROVISION_USER", "provision")
    if run(["id", provision], check=False).returncode == 0:
        if run(["pgrep", "-u", provision], check=False).returncode == 0:
            die("Provisioning account still has running processes; log it out before finalize.")
        archive = STATE_DIR / f"{provision}-home-{int(time.time())}"
        home = Path(pwd.getpwnam(provision).pw_dir)
        run(["usermod", "--lock", "--expiredate", "1", provision])
        if home.exists():
            shutil.move(str(home), archive)
            os.chmod(archive, 0o700)
        run(["userdel", provision])
    Path("/etc/sudoers.d/90-provision").unlink(missing_ok=True)
    state["finalized"] = True
    save_state(state)
    (STATE_DIR / "ready-to-finalize").unlink(missing_ok=True)
    log("stage=finalize result=complete")
    print("Provisioning account removed. Its former home is retained root-only under /var/lib/workstation-firstboot for manual review.")


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Secure, resumable workstation first-boot setup")
    sub = p.add_subparsers(dest="command", required=True)
    for name in ("apply", "validate-input"):
        q = sub.add_parser(name)
        q.add_argument("--source", choices=("keepassxc", "yaml"), default="keepassxc")
        q.add_argument("--database", help="KeePassXC database; defaults to ~/Documents/Secrets/Passwords.kdbx")
        q.add_argument("--entry-prefix", default=KPX_PREFIX)
        q.add_argument("--config", default="config.yaml")
        q.add_argument("--non-interactive", action="store_true")
        q.add_argument("--allow-insecure-input-permissions", action="store_true")
        q.add_argument("--recovery", action="store_true")
        q.add_argument("--accept-config-change", action="store_true")
    sub.add_parser("status")
    f = sub.add_parser("finalize")
    f.add_argument("--recovery", action="store_true")
    return p


def main() -> int:
    os.umask(0o077)
    # Python cannot inherit shell xtrace, but refuse common debug modes anyway.
    if os.environ.get("PYTHONINSPECT") or os.environ.get("WORKSTATION_FIRSTBOOT_DEBUG"):
        print("Refusing debug mode while handling credentials.", file=sys.stderr)
        return 2
    args = parser().parse_args()
    try:
        if args.command == "apply":
            apply(args)
        elif args.command == "validate-input":
            validate_input(args)
        elif args.command == "status":
            status_command()
        elif args.command == "finalize":
            finalize(args)
        return 0
    except KeyboardInterrupt:
        print("Interrupted; secrets were cleaned and no destructive follow-up was attempted.", file=sys.stderr)
        return 130
    except BlockingIOError:
        print("Another first-boot process holds the lock.", file=sys.stderr)
        return 3
    except SetupError as exc:
        log(f"result=failed reason={type(exc).__name__}")
        print(f"ERROR: {exc}", file=sys.stderr)
        print("No destructive follow-up was attempted. Run 'sudo workstation-firstboot status' and consult docs/RECOVERY.md.", file=sys.stderr)
        return 1
    except Exception as exc:
        log(f"result=failed reason={type(exc).__name__}")
        print(f"ERROR: unexpected {type(exc).__name__}; secrets were cleaned and setup stopped.", file=sys.stderr)
        print("Run status and consult recovery documentation before rebooting if LUKS rotation had started.", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
