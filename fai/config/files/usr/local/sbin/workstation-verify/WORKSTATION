#!/bin/bash
set -uo pipefail
fail=0
ok(){ printf 'OK   %s\n' "$1"; }
bad(){ printf 'FAIL %s\n' "$1"; fail=1; }
[ "$(findmnt -n -o FSTYPE /)" = btrfs ] && ok 'root uses Btrfs' || bad 'root is not Btrfs'
for entry in '/:@root' '/home:@home' '/.snapshots:@snapshots'; do
    target=${entry%%:*}; subvol=${entry#*:}; opts=$(findmnt -n -o OPTIONS "$target" 2>/dev/null || true)
    [[ $opts == *"subvol=/$subvol"* || $opts == *"subvol=$subvol"* ]] && ok "$target uses $subvol" || bad "$target does not use $subvol"
done
count=$(btrfs subvolume list / | awk '$NF ~ /^@(root|home|snapshots)$/ {n++} END{print n+0}')
[ "$count" -eq 3 ] && ok 'exactly three managed top-level subvolumes found' || bad "expected three managed subvolumes; found $count"
snapper -c root get-config >/dev/null 2>&1 && ok 'Snapper root config loads' || bad 'Snapper root config fails'
command -v incus >/dev/null && ok 'Incus installed' || bad 'Incus missing'
command -v chezmoi >/dev/null && ok 'chezmoi installed' || bad 'chezmoi missing'
command -v yazi >/dev/null && ok 'Yazi installed' || bad 'Yazi missing'
/usr/local/sbin/grub-security-check >/dev/null 2>&1 && ok 'GRUB authentication policy passes' || bad 'GRUB authentication policy incomplete'
exit "$fail"
