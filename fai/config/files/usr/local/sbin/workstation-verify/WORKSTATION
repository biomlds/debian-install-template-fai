#!/bin/bash
set -uo pipefail
fail=0
check(){
    local description=$1
    shift
    if "$@"; then printf 'OK   %s\n' "$description"; else printf 'FAIL %s\n' "$description"; fail=1; fi
}
check 'signed normal/recovery boot artifacts and pinned baseline' workstation-secureboot check
check 'Snapper root configuration' snapper -c root get-config
check 'Incus installed' command -v incus
check 'chezmoi installed' command -v chezmoi
check 'Flatpak timer enabled' systemctl is-enabled workstation-flatpaks.timer
check 'Security maintenance timer enabled' systemctl is-enabled workstation-security-upgrade.timer
if getent passwd provision >/dev/null; then echo 'FAIL temporary provision account remains'; fail=1; fi
if [ -d /var/lib/workstation-firstboot ]; then echo 'FAIL obsolete first-boot state'; fail=1; fi
check 'UEFI boot manager status' bootctl status
echo 'Review deferred boot-stack security updates with: apt list --upgradable'
exit "$fail"
