#!/bin/bash
set -Eeuo pipefail
export PATH=/usr/bin:/bin:/sbin:/usr/sbin
umask 077
if [ "$EUID" -ne 0 ]; then echo "Run as root" >&2; exit 1; fi
echo "Workstation recovery helper"
if [ ! -d /sys/firmware/efi ]; then echo "UEFI required" >&2; exit 1; fi
lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINT
echo
read -rp "LUKS device (e.g. /dev/nvme0n1p2): " LUKS
read -rp "Crypt name [cryptroot]: " CRYPT
CRYPT=${CRYPT:-cryptroot}
[[ $CRYPT =~ ^[a-zA-Z0-9_-]+$ ]] || { echo "Invalid mapper name." >&2; exit 1; }
# Resolve and validate before opening/mounting anything. Ambiguity requires a
# choice, which is checked against the same physical disk and GPT ESP type.
if ! ESP=$(python3 /usr/local/lib/workstation/recovery.py "$LUKS"); then
    read -rp "ESP device on selected LUKS disk: " ESP
    ESP=$(python3 /usr/local/lib/workstation/recovery.py "$LUKS" "$ESP")
fi
mountpoint -q /mnt/recover && { echo "/mnt/recover is already mounted." >&2; exit 1; }
opened=0
cleanup(){
    if [ "$opened" = 1 ]; then
        umount -R /mnt/recover 2>/dev/null || true
        cryptsetup luksClose "$CRYPT" 2>/dev/null || true
    fi
}
trap cleanup EXIT
cryptsetup luksOpen "$LUKS" "$CRYPT"
opened=1
mkdir -p /mnt/recover
mount -o subvol=@root "/dev/mapper/$CRYPT" /mnt/recover
mount -o subvol=@home "/dev/mapper/$CRYPT" /mnt/recover/home
mount -o subvol=@snapshots "/dev/mapper/$CRYPT" /mnt/recover/.snapshots
mount "$ESP" /mnt/recover/boot
for m in proc sys dev run; do
    mount --rbind /$m /mnt/recover/$m
    mount --make-rslave /mnt/recover/$m
done
echo "Chrooting into /mnt/recover. Type exit to return."
PS1='(recover) ' chroot /mnt/recover /bin/bash
echo "Done"
