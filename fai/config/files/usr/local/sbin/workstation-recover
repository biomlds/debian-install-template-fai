#!/bin/bash
set -Eeuo pipefail
export PATH=/usr/bin:/bin:/sbin:/usr/sbin
umask 077
if [ "$EUID" -ne 0 ]; then echo "Run as root" >&2; exit 1; fi
echo "Workstation recovery helper"
if [ ! -d /sys/firmware/efi ]; then echo "UEFI required" >&2; exit 1; fi
lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINT
echo
read -rp "LUKS device (e.g. /dev/nvme0n1p2): " LUKS
read -rp "Crypt name [cryptroot]: " CRYPT
CRYPT=${CRYPT:-cryptroot}
cryptsetup luksOpen "$LUKS" "$CRYPT"
mkdir -p /mnt/recover
mount -o subvol=@root /dev/mapper/$CRYPT /mnt/recover
mount -o subvol=@home /dev/mapper/$CRYPT /mnt/recover/home
mount -o subvol=@snapshots /dev/mapper/$CRYPT /mnt/recover/.snapshots 2>/dev/null || true
ESP=$(blkid -t LABEL=EFI -o device | head -n1)
if [ -z "$ESP" ]; then read -rp "ESP device: " ESP; fi
mount "$ESP" /mnt/recover/boot
for m in proc sys dev run; do mount --bind /$m /mnt/recover/$m; done
echo "Chrooting into /mnt/recover. Type exit to return."
PS1='(recover) ' chroot /mnt/recover /bin/bash
for m in run dev sys proc; do umount -R /mnt/recover/$m 2>/dev/null || true; done
umount -R /mnt/recover 2>/dev/null || true
cryptsetup luksClose "$CRYPT" 2>/dev/null || true
echo "Done"
