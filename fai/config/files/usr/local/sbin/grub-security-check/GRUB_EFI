#!/bin/bash
set -Eeuo pipefail
cfg=/boot/grub/grub.cfg
[ -s "$cfg" ] || { echo "FAIL grub.cfg missing" >&2; exit 1; }
grep -q '^set superusers=' "$cfg" || { echo "FAIL GRUB superuser missing" >&2; exit 1; }
grep -q '^password_pbkdf2 ' "$cfg" || { echo "FAIL GRUB PBKDF2 hash missing" >&2; exit 1; }
count=$(grep -Ec '^[[:space:]]*menuentry .* --unrestricted ' "$cfg" || true)
[ "$count" -eq 1 ] || { echo "FAIL expected one unrestricted normal entry, found $count" >&2; exit 1; }
if grep -Ei '^[[:space:]]*menuentry .* --unrestricted ' "$cfg" | grep -Ei '(recovery|snapshot|advanced|firmware)' >/dev/null; then
    echo "FAIL sensitive GRUB entry is unrestricted" >&2; exit 1
fi
if grep -E '^password_pbkdf2 .*REPLACE|^password_pbkdf2 .*PLACEHOLDER' "$cfg" >/dev/null; then
    echo "FAIL placeholder GRUB hash" >&2; exit 1
fi
echo "OK GRUB normal boot is unrestricted; editing, shell, recovery, and snapshot entries require authentication."
