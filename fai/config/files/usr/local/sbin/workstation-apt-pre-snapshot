#!/bin/bash
set -euo pipefail
[ -e /run/workstation-install ] && exit 0
[ -n "${WORKSTATION_NO_SNAPSHOT:-}" ] && exit 0
PARENT=$(ps -o comm= -p $PPID 2>/dev/null || true)
case "$PARENT" in
  workstation-update|unattended-upgrade|apt-get|aptitude|apt) ;;
  *) exit 0 ;;
esac
case "$PARENT" in
  workstation-update|unattended-upgrade) exit 0 ;;
esac
NUM=$(/usr/bin/snapper -c root create --type pre --cleanup-algorithm number --description "APT pre-transaction" --print-number 2>/dev/null || true)
[ -n "${NUM:-}" ] && [ "$NUM" != "-" ] && echo "$NUM" > /run/workstation-apt-pre-number
