#!/bin/bash
set -Eeuo pipefail
assets=$FAI/assets
install -d -m 0755 "$target/usr/local/share/workstation-bootstrap" "$target/usr/local/bin" "$target/usr/local/src"
rsync -a "$assets/chezmoi/" "$target/usr/local/share/workstation-bootstrap/chezmoi/"
rsync -a "$assets/incus/" "$target/usr/local/share/workstation-bootstrap/incus/"
for tool in chezmoi yazi ya sbctl; do
    [ -x "$assets/bin/$tool" ] || { echo "Missing host tool: $tool" >&2; exit 1; }
    install -m 0755 "$assets/bin/$tool" "$target/usr/local/bin/$tool"
done
install -d -m 0755 "$target/usr/local/lib/workstation"
install -m 0644 "$assets/workstation/"*.py "$target/usr/local/lib/workstation/"
