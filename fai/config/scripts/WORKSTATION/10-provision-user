#!/bin/bash
set -Eeuo pipefail
: "${PROVISION_USER:?}" "${PROVISION_FULLNAME:?}" "${PROVISION_PASSWORD_HASH_FILE:?}"
if ! $ROOTCMD getent passwd "$PROVISION_USER" >/dev/null; then
    $ROOTCMD useradd --create-home --shell /bin/bash --comment "$PROVISION_FULLNAME" "$PROVISION_USER"
fi
{
    printf '%s:' "$PROVISION_USER"
    tr -d '\r\n' < "$PROVISION_PASSWORD_HASH_FILE"
    printf '\n'
} | $ROOTCMD chpasswd --encrypted
$ROOTCMD usermod --append --groups sudo "$PROVISION_USER"
home=$target/home/$PROVISION_USER
if [ -s "${PROVISION_AUTHORIZED_KEYS_FILE:-}" ]; then
    uid=$($ROOTCMD id -u "$PROVISION_USER")
    gid=$($ROOTCMD id -g "$PROVISION_USER")
    install -d -m 0700 -o "$uid" -g "$gid" "$home/.ssh"
    install -m 0600 -o "$uid" -g "$gid" "$PROVISION_AUTHORIZED_KEYS_FILE" "$home/.ssh/authorized_keys"
fi
fcopy -iM /etc/sudoers.d/90-provision
chmod 0440 "$target/etc/sudoers.d/90-provision"
