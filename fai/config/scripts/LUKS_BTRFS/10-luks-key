#!/bin/bash
set +x
set -Eeuo pipefail
umask 077
: "${LOGDIR:=/tmp/fai}"
: "${target:=/target}"
: "${WORKSTATION_SECRETS:=/run/fai/workstation-secrets}"
BOOTSTRAP_LUKS_FILE=$WORKSTATION_SECRETS/luks
crypttab=$LOGDIR/crypttab
[ -s "$crypttab" ] || { echo "Missing setup-storage crypttab." >&2; exit 1; }
read -r _crypt_name crypt_device setup_key _crypt_options < <(awk '!/^($|#)/ {print; exit}' "$crypttab")
case $crypt_device in UUID=*) crypt_device=/dev/disk/by-uuid/${crypt_device#UUID=} ;; esac
crypt_device=$(readlink -f "$crypt_device")
[ -b "$crypt_device" ] || { echo "Invalid LUKS device." >&2; exit 1; }
[ -s "$setup_key" ] || { echo "Missing setup-storage temporary key." >&2; exit 1; }
[ -s "$BOOTSTRAP_LUKS_FILE" ] || { echo "Missing bootstrap LUKS credential." >&2; exit 1; }
[ "$(cryptsetup luksDump "$crypt_device" | awk '/^Version:/ {print $2; exit}')" = 2 ] || { echo "Expected LUKS2." >&2; exit 1; }
active_slots() {
    cryptsetup luksDump --dump-json-metadata "$crypt_device" | python3 -c \
      'import json,sys; print(" ".join(sorted(json.load(sys.stdin).get("keyslots",{}), key=int)))'
}
matching_slot() {
    local key=$1 slot
    for slot in $(active_slots); do
        if cryptsetup open --test-passphrase --key-slot "$slot" --key-file "$key" "$crypt_device" >/dev/null 2>&1; then
            printf '%s\n' "$slot"; return 0
        fi
    done
    return 1
}
bootstrap_slot=$(matching_slot "$BOOTSTRAP_LUKS_FILE" || true)
setup_slot=$(matching_slot "$setup_key" || true)
if [ -z "$bootstrap_slot" ]; then
    [ -n "$setup_slot" ] || { echo "Neither setup-storage nor bootstrap credential unlocks LUKS." >&2; exit 1; }
    used=" $(active_slots) "; free_slot=''
    for candidate in $(seq 0 31); do case $used in *" $candidate "*) ;; *) free_slot=$candidate; break ;; esac; done
    [ -n "$free_slot" ] || { echo "No free LUKS2 keyslot." >&2; exit 1; }
    cryptsetup luksAddKey --pbkdf argon2id --key-file "$setup_key" --new-key-slot "$free_slot" \
        "$crypt_device" "$BOOTSTRAP_LUKS_FILE" >/dev/null
    bootstrap_slot=$(matching_slot "$BOOTSTRAP_LUKS_FILE") || { echo "Bootstrap key verification failed." >&2; exit 1; }
fi
if [ -n "$setup_slot" ]; then
    [ "$bootstrap_slot" != "$setup_slot" ] || { echo "Bootstrap key did not receive a distinct keyslot." >&2; exit 1; }
    set -- $(active_slots)
    [ "$#" -ge 2 ] || { echo "Refusing to remove setup key: fewer than two active slots." >&2; exit 1; }
    cryptsetup luksKillSlot --key-file "$BOOTSTRAP_LUKS_FILE" "$crypt_device" "$setup_slot" >/dev/null
    if cryptsetup open --test-passphrase --key-file "$setup_key" "$crypt_device" >/dev/null 2>&1; then
        echo "Setup-storage key remains active; installation stopped." >&2; exit 1
    fi
fi
cryptsetup open --test-passphrase --key-slot "$bootstrap_slot" --key-file "$BOOTSTRAP_LUKS_FILE" \
    "$crypt_device" >/dev/null 2>&1 || { echo "Bootstrap key verification failed after transition." >&2; exit 1; }
luks_uuid=$(cryptsetup luksUUID "$crypt_device")
install -d -m 0755 "$target/etc/workstation"
printf '%s\n' "$luks_uuid" > "$target/etc/workstation/luks-uuid"
printf 'cryptroot UUID=%s none luks\n' "$luks_uuid" > "$target/etc/crypttab"
printf 'cryptroot UUID=%s none luks\n' "$luks_uuid" > "$LOGDIR/crypttab"
rm -f -- "$setup_key"
# The permanent passphrase is never copied into the target root.
