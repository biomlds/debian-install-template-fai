#!/bin/bash
set +x
set -Eeuo pipefail
trap 'rc=$?; echo "FINAL/99-finalize failed at line $LINENO (status $rc)." >&2' ERR
# shellcheck disable=SC1090
source "${LOGDIR:-/tmp/fai}/disk-selection.env"
# 10-setup creates local (not fai-package) diversions and replaces the Debian
# ESP hooks with no-op stubs. Keep them: FAI diversion cleanup would not remove
# local diversions, and restoring the real hooks would overwrite signed artifacts.
# FAI keeps the package database/cache in temporary mounts during configure.
# Flush them BEFORE the baseline snapshot so recovery has a complete dpkg DB.
mkramdisk -au || { echo "Failed to flush package ramdisks before the baseline snapshot." >&2; exit 1; }
# Restore installer no-op programs before saving a recoverable root. This removes
# only diversions owned by package fai; our local boot-hook diversions remain.
fai-divert -R
remaining_diversions=$($ROOTCMD dpkg-divert --list fai)
[ -z "$remaining_diversions" ] || { echo "FAI diversions remain; refusing baseline snapshot." >&2; exit 1; }
fcopy -riM /etc/systemd/system
fcopy -riM /usr/local/sbin
chmod 0755 "$target/usr/local/sbin/"{workstation-*,incus-init-workstation}
install -d -m 0700 "$target/var/log/fai" "$target/run/workstation-secrets"
install -m 0600 "${LOGDIR:-/tmp/fai}/disk-selection.json" "$target/var/log/fai/disk-selection.json"
install -m 0600 "${LOGDIR:-/tmp/fai}/disk-selection.log" "$target/var/log/fai/disk-selection.log"
bound=0
cleanup(){
    if [ "$bound" = 1 ]; then umount "$target/run/workstation-secrets"; fi
    rm -f "$target/run/workstation-install"
    python3 "$FAI/assets/workstation/kdbx.py" cleanup
}
trap cleanup EXIT
mount --bind /run/fai/workstation-secrets "$target/run/workstation-secrets" || {
    echo "Failed to bind installer secrets into the target." >&2; exit 1;
}
bound=1
touch "$target/run/workstation-install"
$ROOTCMD systemctl enable ssh.service workstation-flatpaks.timer workstation-uki-check.timer \
    workstation-security-upgrade.timer
$ROOTCMD systemctl enable fwupd-refresh.timer 2>/dev/null || true
# bootctl install writes the NVRAM "Linux Boot Manager" entry and puts it first
# in BootOrder (more reliable than a manual efibootmgr inside the chroot).
# It copies the unsigned loader first; workstation-secureboot replaces the ESP
# copies with signed ones below.
$ROOTCMD bootctl --esp-path=/boot install
$ROOTCMD workstation-secureboot install --secrets /run/workstation-secrets
$ROOTCMD bootctl --esp-path=/boot is-installed
# Remove stale type-1 loader entries written by kernel-install during instsoft
# (before layout=other hooks were deployed). boot.py publishes signed type-2 UKIs
# under /boot/EFI/Linux; raw-kernel auto-entries are disabled in loader.conf.
# vmlinuz-*/initrd are kept on the ESP because build_normal() uses them as the
# UKI source.
if [ -d "$target/boot/loader/entries" ]; then
    rm -f "$target/boot/loader/entries/"*.conf
fi
$ROOTCMD systemctl daemon-reload
echo 'Installation signed. Boot a recovery entry and run: sudo workstation-secureboot confirm'
