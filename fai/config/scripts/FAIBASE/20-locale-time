#!/bin/bash
set -Eeuo pipefail
: "${LOCALE:?}" "${TIMEZONE:?}" "${KEYMAP:?}"
printf '%s UTF-8\n' "$LOCALE" > "$target/etc/locale.gen"
printf 'LANG=%s\n' "$LOCALE" > "$target/etc/default/locale"
printf 'KEYMAP=%s\n' "$KEYMAP" > "$target/etc/default/keyboard"
ln -snf "/usr/share/zoneinfo/$TIMEZONE" "$target/etc/localtime"
printf '%s\n' "$TIMEZONE" > "$target/etc/timezone"
$ROOTCMD locale-gen
