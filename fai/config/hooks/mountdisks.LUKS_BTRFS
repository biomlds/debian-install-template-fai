#!/bin/bash
set -Eeuo pipefail
: "${LOGDIR:=/tmp/fai}"
: "${target:=/target}"
crypttab=$LOGDIR/crypttab
fstab=$LOGDIR/fstab
[ -s "$crypttab" ] || { echo "Missing setup-storage crypttab." >&2; exit 1; }
[ -s "$fstab" ] || { echo "Missing setup-storage fstab." >&2; exit 1; }
read -r crypt_name _crypt_device _crypt_key _crypt_options < <(awk '!/^($|#)/ {print; exit}' "$crypttab")
mapper=/dev/mapper/$crypt_name
[ -b "$mapper" ] || { echo "Encrypted mapper is not open: $mapper" >&2; exit 1; }
fs_type=$(blkid -s TYPE -o value "$mapper" || true)
if [ -z "$fs_type" ]; then
    mkfs.btrfs -f -L debian-root "$mapper"
elif [ "$fs_type" != btrfs ]; then
    echo "Encrypted volume is $fs_type, expected btrfs: $mapper" >&2
    exit 1
fi
efi_spec=$(awk '$2 == "/boot" {print $1; exit}' "$fstab")
[ -n "$efi_spec" ] || { echo "No EFI entry in setup-storage fstab." >&2; exit 1; }

top=/run/fai/btrfs-top
top_mounted=0
cleanup_top(){
    if [ "$top_mounted" -eq 1 ]; then
        umount "$top" 2>/dev/null || true
    fi
}
trap cleanup_top EXIT
mkdir -p "$top" "$target"
if ! mountpoint -q "$top"; then
    mount -o subvolid=5 "$mapper" "$top"
fi
top_mounted=1
for subvol in @root @home @snapshots; do
    if [ ! -e "$top/$subvol" ]; then
        btrfs subvolume create "$top/$subvol"
    elif ! btrfs subvolume show "$top/$subvol" >/dev/null 2>&1; then
        echo "$top/$subvol exists but is not a subvolume." >&2
        exit 1
    fi
done
root_id=$(btrfs subvolume show "$top/@root" | awk -F': *' '/Subvolume ID:/ {print $2; exit}')
[ -n "$root_id" ] || { echo "Could not determine the @root subvolume ID." >&2; exit 1; }
btrfs subvolume set-default "$root_id" "$top"
umount "$top"
top_mounted=0
trap - EXIT

# Do not mount the target here. FAI's task_mountdisks runs mount2dir on this
# fstab immediately after the hook; mounting here would overmount every entry
# and make findmnt report each filesystem twice.
efi_device=$(findfs "$efi_spec")
[ -b "$efi_device" ] || { echo "EFI device not found: $efi_spec" >&2; exit 1; }
[ "$(blkid -s TYPE -o value "$efi_device")" = vfat ] || { echo "EFI partition is not vfat: $efi_device" >&2; exit 1; }

root_uuid=$(blkid -s UUID -o value "$mapper")
efi_uuid=$(blkid -s UUID -o value "$efi_device")
cat > "$LOGDIR/fstab" <<FSTAB
UUID=$root_uuid /           btrfs noatime,compress=zstd:3,subvol=@root       0 0
UUID=$root_uuid /home       btrfs noatime,compress=zstd:3,subvol=@home       0 0
UUID=$root_uuid /.snapshots btrfs noatime,compress=zstd:3,subvol=@snapshots  0 0
UUID=$efi_uuid  /boot       vfat  umask=0077                                0 1
FSTAB
if [ -f "$LOGDIR/disk_var.sh" ]; then sed -i '/^ROOT_PARTITION=/d' "$LOGDIR/disk_var.sh"; fi
printf 'ROOT_PARTITION=%q\n' "$mapper" >> "$LOGDIR/disk_var.sh"
