# disk1 is mapped to the interactively selected kernel device by partition.WORKSTATION.
# Recovery UKIs on the ESP are explicitly paired with protected root snapshots.
disk_config disk1 disklabel:gpt bootable:1 fstabkey:uuid align-at:1M
p=efi      /boot       2G   vfat rw,umask=0077 createopts="-n EFI"
p=          -           8G-  -    -

disk_config cryptsetup
luks - disk1.2 btrfs - lukscreateopts="--type=luks2 --pbkdf=argon2id"
