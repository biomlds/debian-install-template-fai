# Public policy and paths only; KDBX values are never shell environment variables.
WORKSTATION_SECRETS=/run/fai/workstation-secrets
TIMEZONE=America/Edmonton
LOCALE=en_CA.UTF-8
KEYMAP=us
# Keep setup-storage's key only until 10-luks-key verifies its replacement.
FAI_KEEP_CRYPTKEYFILE=1
# Do not let FAI continue to default partitioning or FINAL after hook/script errors.
STOP_ON_ERROR=0
export WORKSTATION_SECRETS TIMEZONE LOCALE KEYMAP FAI_KEEP_CRYPTKEYFILE STOP_ON_ERROR
